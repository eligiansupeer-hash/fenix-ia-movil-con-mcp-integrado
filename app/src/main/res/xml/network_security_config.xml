<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Permitir HTTP plano exclusivamente en localhost e interfaces loopback locales del dispositivo -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">::1</domain>
    </domain-config>

    <!-- Exigir HTTPS/TLS estricto para cualquier conexión saliente externa a Internet -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>

